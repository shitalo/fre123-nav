{
	"name": "fre123_web",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"prepare:static-data": "node scripts/prepare-static-data.mjs",
		"prepare:github-assets": "node scripts/prepare-github-assets.mjs",
		"prepare:site-data": "yarn prepare:static-data && yarn prepare:github-assets",
		"build": "yarn prepare:site-data && node ./node_modules/nuxt/bin/nuxt.mjs build",
		"dev": "yarn prepare:site-data && node ./node_modules/nuxt/bin/nuxt.mjs dev",
		"generate": "yarn prepare:site-data && node ./node_modules/nuxt/bin/nuxt.mjs generate",
		"preview": "node ./node_modules/nuxt/bin/nuxt.mjs preview",
		"postinstall": "node ./node_modules/nuxt/bin/nuxt.mjs prepare"
	},
	"devDependencies": {
		"@nuxt/devtools": "^3.4.0",
		"@types/node": "^22.20.1",
		"nuxt": "^3.21.10",
		"sass": "^1.102.0"
	},
	"dependencies": {
		"@nuxtjs/tailwindcss": "^6.14.0",
		"@pinia/nuxt": "^0.11.3",
		"@vueuse/core": "^14.4.0",
		"@vueuse/nuxt": "^14.4.0",
		"ohmyfetch": "0.4.21",
		"pinia": "^3.0.4",
		"yarn": "1.22.21"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
